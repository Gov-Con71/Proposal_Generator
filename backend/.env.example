# Backend environment — copy to .env and fill in. Never commit real secrets.

# --- Core ---
DATABASE_URL=postgresql://user:password@localhost:5432/rfp_proposal_db
ENVIRONMENT=development            # development | staging | production
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM provider (decoupled via app/services/llm) ---
# Swap AI platforms here: 'gemini', 'featherless', or 'openai_compatible' (any
# other OpenAI-compatible host — OpenRouter, Together, a self-hosted
# vLLM/Ollama/LM Studio instance, ... — via LLM_BASE_URL/LLM_API_KEY below, no
# new code needed).
# Keep these in step with config.py's defaults. A .env file OUTRANKS those
# defaults, and backend/.env is gitignored — so it never receives a fix made to
# the committed code, and a stale copy of this template silently reinstates a
# retired model. gemini-2.0-flash and text-embedding-004 are both retired and
# now 404, which fails every ingestion at the extract step.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=your-gemini-api-key
# For LLM_PROVIDER=featherless (flat-rate, no per-day cap): FEATHERLESS_API_KEY.
FEATHERLESS_API_KEY=
# For LLM_PROVIDER=openai_compatible: LLM_BASE_URL (e.g.
# https://openrouter.ai/api/v1) and LLM_API_KEY.
LLM_BASE_URL=
LLM_API_KEY=
# Optional: a cheaper/faster model (and, via LLM_PROVIDER_LIGHT, optionally a
# different provider) for mechanical calls that don't need LLM_MODEL's
# quality — HyDE query generation and compliance/solicitation extraction. Both
# empty (default) disables tiering entirely; those calls use LLM_MODEL /
# LLM_PROVIDER, same as before either setting existed.
LLM_MODEL_LIGHT=
LLM_PROVIDER_LIGHT=

# --- Object storage (S3 / LocalStack) ---
USE_LOCALSTACK=true
LOCALSTACK_ENDPOINT=http://localhost:4566
S3_BUCKET_NAME=proposal-artifacts-local
AWS_DEFAULT_REGION=us-east-1
# For real AWS S3 (USE_LOCALSTACK=false), also set:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
MAX_UPLOAD_BYTES=52428800         # 50 MB

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# --- Cache (Story 4.4) ---
CACHE_URL=redis://localhost:6379/2
CACHE_TTL_SECONDS=60
CACHE_ENABLED=true

# --- Observability (Sprint 5) ---
TELEMETRY_ENABLED=true
SENTRY_DSN=                        # leave empty to disable Sentry
# Comma-separated allowed CORS origins (set to your Vercel domain in prod).
CORS_ORIGINS=http://localhost:3000
