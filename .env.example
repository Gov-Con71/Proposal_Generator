# Root environment for Docker Compose. Copy to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored — never commit real secrets.
#
# Docker Compose auto-loads this file for ${VAR} substitution in
# docker-compose.yml and docker-compose.db.yml.

# =========================================================================
# Database containers (consumed by docker-compose.db.yml / docker-compose.yml)
# =========================================================================
POSTGRES_USER=rfp_admin
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=rfp_proposal_db
POSTGRES_PORT=5432

REDIS_PORT=6379
LOCALSTACK_PORT=4566

# =========================================================================
# Backend application
# =========================================================================
# When the backend runs on the host, point at localhost; inside the compose
# network the service name (db / redis / localstack) is used instead.
DATABASE_URL=postgresql://rfp_admin:change-me-strong-password@localhost:5432/rfp_proposal_db
ENVIRONMENT=development            # development | staging | production
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# Short on purpose: the access token lives only in the browser's memory and is
# reissued from the refresh cookie, so a long life buys nothing and delays
# revoking a deactivated account.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh tokens rotate on every use and are revoked on logout.
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Refresh cookie ---
# The refresh token is delivered as an HttpOnly cookie so no script can read it.
# Dev (localhost:3000 → localhost:8000) is same-site, so Lax works over plain
# HTTP. In production the Vercel app and the API are different registrable
# domains — i.e. cross-site — where the browser drops the cookie unless it is
# SameSite=none, and ignores SameSite=none unless Secure is also set:
#   COOKIE_SAMESITE=none
#   COOKIE_SECURE=true
# The failure is specific and confusing: login succeeds, then every refresh 401s
# because the cookie was never stored.
REFRESH_COOKIE_NAME=proposalai_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Leave blank for a host-only cookie. Set only if the API and app share a parent
# domain and the cookie must reach both.
COOKIE_DOMAIN=

# Minimum password length. Length is the only dimension that reliably resists
# offline cracking; composition rules mostly produce P@ssw0rd1.
PASSWORD_MIN_LENGTH=12

# New accounts per IP per window. Registration has no account to key on, which
# is why it needs its own limit.
REGISTER_MAX_PER_IP=5
REGISTER_WINDOW_SECONDS=3600

# Lifetime of the single-use ticket that authorises an SSE progress stream.
# Long enough to hand to EventSource, short enough that a copy in an access log
# is already dead.
STREAM_TICKET_TTL_SECONDS=30

# --- LLM provider (decoupled via app/services/llm) ---
# Swap AI platforms here: 'gemini' or 'featherless'.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_API_KEY=your-gemini-api-key

# For LLM_PROVIDER=featherless (OpenAI-compatible, flat-rate, no per-day cap), set:
#   LLM_PROVIDER=featherless
#   LLM_MODEL=Qwen/Qwen2.5-72B-Instruct        # any Featherless chat model id
#   EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B     # supports dimensions=768
FEATHERLESS_API_KEY=your-featherless-api-key

# --- Object storage (S3 / LocalStack) ---
USE_LOCALSTACK=true
LOCALSTACK_ENDPOINT=http://localhost:4566
S3_BUCKET_NAME=proposal-artifacts-local
AWS_DEFAULT_REGION=us-east-1
# For real AWS S3 (USE_LOCALSTACK=false), also set:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
MAX_UPLOAD_BYTES=52428800          # 50 MB

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# --- Cache ---
CACHE_URL=redis://localhost:6379/2
CACHE_TTL_SECONDS=60
CACHE_ENABLED=true

# --- Observability ---
TELEMETRY_ENABLED=true
SENTRY_DSN=                        # leave empty to disable Sentry
CORS_ORIGINS=http://localhost:3000

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR. INFO carries the pipeline's progress trail
# ("Ingestion start", "Ingestion complete: requirements=N", per-section
# drafting, per-call LLM latency) — the sequence you follow to a root cause.
# Raise to DEBUG when reproducing a specific failure; it is noisy.
LOG_LEVEL=INFO
# json | console. Empty means decide from ENVIRONMENT: json in production
# (queryable by field in an aggregator), console elsewhere (readable in a
# terminal). Set explicitly to override.
LOG_FORMAT=
# Logs non-sensitive request headers on every request. Off by default — logged
# headers are the usual way credentials reach a log aggregator. Authorization
# and Cookie are stripped even when this is on. Bodies are never logged.
LOG_REQUEST_HEADERS=false
