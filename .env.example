# Root environment for Docker Compose. Copy to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored — never commit real secrets.
#
# Docker Compose auto-loads this file for ${VAR} substitution in
# docker-compose.yml and docker-compose.db.yml.

# =========================================================================
# Database containers (consumed by docker-compose.db.yml / docker-compose.yml)
# =========================================================================
POSTGRES_USER=rfp_admin
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=rfp_proposal_db
POSTGRES_PORT=5432

REDIS_PORT=6379
LOCALSTACK_PORT=4566

# =========================================================================
# Backend application
# =========================================================================
# When the backend runs on the host, point at localhost; inside the compose
# network the service name (db / redis / localstack) is used instead.
DATABASE_URL=postgresql://rfp_admin:change-me-strong-password@localhost:5432/rfp_proposal_db
ENVIRONMENT=development            # development | staging | production
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Refresh tokens rotate on every use and are revoked on logout.
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- LLM provider (decoupled via app/services/llm) ---
# Swap AI platforms here; only 'gemini' ships today. Adding one = a new adapter.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=text-embedding-004
GEMINI_API_KEY=your-gemini-api-key

# --- Object storage (S3 / LocalStack) ---
USE_LOCALSTACK=true
LOCALSTACK_ENDPOINT=http://localhost:4566
S3_BUCKET_NAME=proposal-artifacts-local
AWS_DEFAULT_REGION=us-east-1
# For real AWS S3 (USE_LOCALSTACK=false), also set:
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
MAX_UPLOAD_BYTES=52428800          # 50 MB

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false

# --- Cache ---
CACHE_URL=redis://localhost:6379/2
CACHE_TTL_SECONDS=60
CACHE_ENABLED=true

# --- Observability ---
TELEMETRY_ENABLED=true
SENTRY_DSN=                        # leave empty to disable Sentry
CORS_ORIGINS=http://localhost:3000
